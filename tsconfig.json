{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "core/**/*.ts",
    "agents/**/*.ts",
    "integrations/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
